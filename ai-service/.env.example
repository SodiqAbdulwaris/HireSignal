AI_SERVICE_PORT=

# Shared secret required on the X-Service-Key header of /parse/ and
# /match/, when set. Leave empty for local dev. Set this (matching the
# backend's AI_SERVICE_API_KEY) wherever this service is reachable from
# anywhere other than the trusted backend network.
AI_SERVICE_API_KEY=

EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_TOKEN=
MODEL_CACHE_DIR=

MAX_FILE_SIZE_MB=

PARSER_AI_ENABLED=
PARSER_AI_URL=
PARSER_AI_API_KEY=
PARSER_AI_TIMEOUT_SECONDS=