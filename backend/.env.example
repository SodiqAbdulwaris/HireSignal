PORT=5000
MONGODB_URI=

JWT_SECRET=

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
# Shared secret sent as X-Service-Key to the AI service. Optional locally;
# set this (and the matching AI_SERVICE_API_KEY on the AI service) whenever
# the AI service is reachable from anywhere other than this backend.
AI_SERVICE_API_KEY=
MAX_FILE_SIZE_BYTES=5242880

ACCESS_TOKEN_EXPIRY=15m

# Public HTTPS frontend. Verification and reset emails always use this origin.
FRONTEND_URL=https://app.example.com
# Exact browser origins allowed to call the API. Include all LAN IPs with ports.
CORS_ALLOWED_ORIGINS=https://app.example.com,http://192.168.1.25:5173
# Cross-site cookies for a hosted API and separate frontend origin.
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_SECURE=true

DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FEEDBACK_TO_EMAIL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
