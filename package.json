{
  "name": "ai-resume-screener",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && pip install -r ai-service/requirements.txt",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "ai": "cd ai-service && python -m uvicorn app.main:app --reload",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\" \"npm run ai\"",
    "prepare": "git config core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SodiqAbdulwaris/AI-Resume-Screener.git"
  },
